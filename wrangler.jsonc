{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hayate-docs",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
