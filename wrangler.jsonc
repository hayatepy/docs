{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hayate-docs",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "preview_urls": false,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "hayatepy.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
